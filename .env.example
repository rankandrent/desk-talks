# A generated secret for Payload (openssl rand -hex 32)
PAYLOAD_SECRET=

# Public URL of the site (used for SEO, sitemap, share links)
SITE_URL=http://localhost:3000

# Local-only: first admin account created by `pnpm seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# One-time link key for creating the first dashboard admin (/admin/create-first-user?setup=...)
SETUP_KEY=
